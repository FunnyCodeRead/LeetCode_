/**
 * @param {string} haystack
 * @param {string} needle
 * @return {number}
 */
var strStr = function(haystack, needle) {
    const lenhayStack =haystack.length;
    const lengNeedle =needle.length;

    if(lengNeedle > lenhayStack){
        return -1;
    }
    for(let i =0 ; i < lenhayStack -lengNeedle+1; i++){
        let j = 0;
        while(j <lengNeedle && haystack[i + j] == needle[j]){
            j++;
        }

        if(j == lengNeedle){
            return i;
        }
    }
    return -1;
};
